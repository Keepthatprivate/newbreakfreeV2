# Database URL (use the same address in development, only use pooled in production if you use neon.tech)
# https://neon.tech/docs/guides/prisma
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

## * Redis (Required for caching)
# Get from: Railway ($5/mo), Redis Cloud (free tier), Upstash, or local Docker
# Railway: redis://default:password@host:port
# Redis Cloud: redis://default:password@host:port
# Local: redis://localhost:6379
REDIS_URL=""

## * OAuth (for social login)
# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## * BetterAuth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

## * Resend (for transactional emails)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
EMAIL_FROM="contact@boilersaas.com" # ex: "BoilerSaaS <contact@boilersaas.com>"
NEXT_PUBLIC_EMAIL_CONTACT="contact@boilersaas.com"

## * Stripe (for payments)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Default plans (for SaaS subscriptions)
STRIPE_PRO_PLAN_ID=""
STRIPE_PRO_YEARLY_PLAN_ID=""
STRIPE_ULTRA_PLAN_ID=""
STRIPE_ULTRA_YEARLY_PLAN_ID=""
# Custom plans (for specific products/funnels)
STRIPE_ASTROLOGY_MONTHLY_PRICE_ID=""
STRIPE_ASTROLOGY_YEARLY_PRICE_ID=""

## * Analytics (optional)
# Google Analytics 4
NEXT_PUBLIC_GA_ID=""
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=""
# Microsoft Clarity
NEXT_PUBLIC_CLARITY_ID=""
# Meta Pixel (Facebook/Instagram) - client-side
NEXT_PUBLIC_FB_PIXEL_ID=""
# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
# Twitter/X Pixel
NEXT_PUBLIC_TWITTER_PIXEL_ID=""
# LinkedIn Insight Tag
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
# PostHog (legacy)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

## * Meta Conversions API (CAPI) - server-side tracking (optional)
# Server-side Pixel ID (same as NEXT_PUBLIC_FB_PIXEL_ID)
FB_PIXEL_ID=""
# Access token from Meta Events Manager
FB_CAPI_TOKEN=""
# Graph API version (default: v24.0)
FB_GRAPH_VERSION="v24.0"

## * Discord Webhooks (optional notifications)
DISCORD_WEBHOOK_PAYMENT=""
DISCORD_WEBHOOK_PAYMENT_FAILED=""
DISCORD_WEBHOOK_SIGNUP=""
DISCORD_WEBHOOK_SUBSCRIPTION_CANCELED=""
DISCORD_WEBHOOK_TRIAL=""

## * File Upload (choose one provider)
# Vercel Blob (default): BLOB_READ_WRITE_TOKEN is auto-configured on Vercel
# For local dev with Vercel Blob, get token from: Vercel Dashboard > Storage > Blob > Tokens
BLOB_READ_WRITE_TOKEN=""

# Cloudflare R2 / AWS S3 (alternative - see docs/file-adapters)
# AWS_ENDPOINT=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET_NAME=""
# R2_URL=""
